mes = np.arange(12) + 1 # meses de 1 a 12

# quantidades de produtos vendidos por mês. As entradas são de Janeiro a Dezembro
creme_facial = np.array([ 2500, 2630, 2140, 3400, 3600, 2760, 2980, 3700, 3540, 1990, 2340, 2900 ])
limpeza_facial = np.array([ 1500, 1200, 1340, 1130, 1740, 1555, 1120, 1400, 1780, 1890, 2100, 1760 ])
pasta_dentaria = np.array([ 5200, 5100, 4550, 5870, 4560, 4890, 4780, 5860, 6100, 8300, 7300, 7400 ])
sabonete = np.array([ 9200, 6100, 9550, 8870, 7760, 7490, 8980, 9960, 8100, 10300, 13300, 14400 ])
shampoo = np.array([ 1200, 2100, 3550, 1870, 1560, 1890, 1780, 2860, 2100, 2300, 2400, 1800 ])
hidratante = np.array([ 1500, 1200, 1340, 1130, 1740, 1555, 1120, 1400, 1780, 1890, 2100, 1760 ])

# Gráfico 1 - Total de produtos Vendidos por mês - Linha
total_por_mes = (
    creme_facial
    + limpeza_facial
    + pasta_dentaria
    + sabonete
    + shampoo
    + hidratante
)
print(total_por_mes)

x = mes
fig, ax = plt.subplots()
ax.plot(x, total_por_mes)

plt.show()

# Gráfico 2 - Gráfico com todos os produtos vendidos por mês - Linha
x = mes

fig, ax = plt.subplots()

ax.plot(x, creme_facial, label= "Creme facial")
ax.plot(x, limpeza_facial, label= "Limpeza facial")
ax.plot(x, pasta_dentaria, label= "Pasta dentaria")
ax.plot(x, sabonete, label= "Sabonete")
ax.plot(x, shampoo, label= "Shampoo")
ax.plot(x, hidratante, label= "Hidratante")

ax.set_title("Produtos vendidos por mes")
ax.set_xlabel("Mes")
ax.set_ylabel("Quantidade vendida")

ax.legend()
plt.show()

# Gráfico 3 - Comparativo de Creme Facial com Limpeza Facial por mês - Barras
x = np.arange(len(mes))
fig, ax = plt.subplots()

largura = 0.4

ax.bar(x - largura/2, creme_facial, largura, label="Creme facial")
ax.bar(x + largura/2, limpeza_facial, largura, label="Limpeza facial")

ax.set_title("Comparativo de Creme Facial com Limpeza Facial por mes")
ax.set_xlabel("Mes")
ax.set_ylabel("Quantidade vendida")

ax.set_xticks(x)
ax.set_xticklabels(mes)

ax.legend()
plt.show()

# Gráfico 4 - Stack plot com o total de produtos vendidos a cada mês com todos os produtos
x = mes
fig, ax = plt.subplots(figsize=(12, 6))

ax.stackplot(
    x,
    creme_facial,
    limpeza_facial,
    pasta_dentaria,
    sabonete,
    shampoo,
    hidratante,
    labels=[
        "Creme facial",
        "Limpeza facial",
        "Pasta dentaria",
        "Sabonete",
        "Shampoo",
        "Hidratante"
    ]
)

ax.set_title("Total de produtos vendidos por mes")
ax.set_xlabel("Mes")
ax.set_ylabel("Quantidade vendida")

ax.legend(loc="upper left")
plt.show()

# Gráfico 5 - Pizza com % da quantidade produtos vendidos no ano em cada produto
produtos = [
    np.sum(creme_facial),
    np.sum(limpeza_facial),
    np.sum(pasta_dentaria),
    np.sum(sabonete),
    np.sum(shampoo),
    np.sum(hidratante)
]

nomes = [
    "Creme facial",
    "Limpeza facial",
    "Pasta dentaria",
    "Sabonete",
    "Shampoo",
    "Hidratante"
]

fig, ax = plt.subplots(figsize=(8, 8))

ax.pie(
    produtos,
    labels=nomes,
    autopct="%1.1f%%"
)

ax.set_title("Percentual de produtos vendidos no ano")
plt.show()
